{
  "$schema": "https://pages.edgeone.ai/schema/edgeone.json",
  "name": "sysanalyst-quiz",
  "framework": "nextjs",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "redirects": [
    {
      "source": "/sitemap.xml/",
      "destination": "/sitemap.xml",
      "statusCode": 301
    },
    {
      "source": "/robots.txt/",
      "destination": "/robots.txt",
      "statusCode": 301
    }
  ]
}
